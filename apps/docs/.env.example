# Optional. Component docs work without a registry; the themes page falls back
# to the built-in presets when it cannot reach one.
# THEME_REGISTRY_URL="http://localhost:4100"

# Optional. Enables publishing from the Theme Studio. Must match the registry's
# REGISTRY_PUBLISH_SECRET.
# THEME_REGISTRY_SECRET="generate-with-openssl-rand-base64-32"
