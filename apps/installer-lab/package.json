        "svelte": "^5.57.3",
        "svelte-check": "^4.7.5",
        "tailwindcss": "^4.2.2",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vitest": "^4.1.12"
    },
    "dependencies": {
        "@fontsource/dm-sans": "^5.3.0",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@sivir-ui/svelte": "workspace:*"
