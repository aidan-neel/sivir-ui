// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

// URLs live in prisma.config.ts (Prisma 7+).
// - Runtime queries: src/lib/prisma.ts reads DATABASE_URL (Supabase transaction pooler, port 6543).
// - Migrations: prisma.config.ts → DIRECT_URL (Supabase session/direct, port 5432).
datasource db {
  provider = "postgresql"
}

/// A community theme. `document` holds the complete, validated portable `Theme`
/// from `@sivir-ui/svelte/themes/theme`; the scalar columns mirror its identity
/// fields so listing, search, and slug uniqueness never have to read JSON.
model Theme {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  description   String
  publisher     String?
  version       Int
  document      Json
  /// SHA-256 of the edit token returned once at publish time.
  editTokenHash String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
}

/// Append-only publish log for rate limiting. Unpublishing a theme never
/// removes its event, so deletes cannot free quota.
model PublishEvent {
  id        String   @id @default(cuid())
  /// Opaque, salted client fingerprint supplied by the trusted publishing proxy.
  clientKey String
  createdAt DateTime @default(now())

  @@index([clientKey, createdAt])
}

/// Tombstone for built-in default themes that an admin has chosen to hide.
/// Listing the registry skips defaults whose slug appears here.
model HiddenDefault {
  slug     String   @id
  hiddenAt DateTime @default(now())
}
